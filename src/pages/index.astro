---
import Base from '$lib/layouts/Base.astro';
import Thoughts from './_thoughts.astro';
import surplus from './affiliations/surplus.svg';
import groq from './affiliations/groq.svg';
import originality from './affiliations/originality.svg';
import svgo from './affiliations/svgo.svg';
import vanta from './affiliations/vanta.svg';
import skyclient from './affiliations/skyclient.svg';
import verifyinginference from './projects/verifying-inference.svg';
import m3svelte from './projects/m3svelte.svg';
import abundance from './projects/abundance.svg';
import trigonometry from './projects/trigonometry.svg';
import softui from './projects/softui.svg';

// [image, center x, center y, width, rotation]
type Sticker = [ImageMetadata, number, number, number, number];
const affiliations: Sticker[] = [
  [groq, 1500, 260, 1100, 14],
  [surplus, 640, 170, 1400, -9],
  [skyclient, 1350, 860, 1250, 7],
  [svgo, 1700, 640, 900, -12],
  [originality, 820, 480, 1300, 4],
  [vanta, 430, 790, 1000, -16],
];
const projects: Sticker[] = [
  [verifyinginference, 1550, 250, 1000, 10],
  [m3svelte, 700, 200, 1300, -6],
  [trigonometry, 1150, 500, 1400, 5],
  [softui, 1550, 820, 900, 8],
  [abundance, 650, 790, 1300, -10],
];
const panels: [string, Sticker[]][] = [
  ['/affiliations/', affiliations],
  ['/projects/', projects],
];
---

<Base title="Kendell">
  <svg width="0" height="0" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="sticker" x="-15%" y="-50%" width="130%" height="200%">
        <feMorphology in="SourceAlpha" operator="dilate" radius="8"></feMorphology>
        <feGaussianBlur stdDeviation="8"></feGaussianBlur>
        <feComponentTransfer result="cut">
          <feFuncA type="linear" slope="20" intercept="-1"></feFuncA>
        </feComponentTransfer>
        <feFlood flood-color="#000"></feFlood>
        <feComposite in2="cut" operator="in"></feComposite>
        <feMerge>
          <feMergeNode></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>
  </svg>
  <div class="quad">
    <div class="me">
      <p>
        EHLO; I'm Kendell. I like intelligence too cheap to meter, information and compression,
        convenience and mobility, and fighting bad actors.
      </p>
    </div>
    <div class="links">
      <div class="split">
        <a class="layer" href="https://github.com/KTibow">GitHub</a>
        <a class="layer" href="https://github.com/sponsors/KTibow"
          ><svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><title>GitHub Sponsors</title><path
              d="M17.625 1.499c-2.32 0-4.354 1.203-5.625 3.03-1.271-1.827-3.305-3.03-5.625-3.03C3.129 1.499 0 4.253 0 8.249c0 4.275 3.068 7.847 5.828 10.227a33.14 33.14 0 0 0 5.616 3.876l.028.017.008.003-.001.003c.163.085.342.126.521.125.179.001.358-.041.521-.125l-.001-.003.008-.003.028-.017a33.14 33.14 0 0 0 5.616-3.876C20.932 16.096 24 12.524 24 8.249c0-3.996-3.129-6.75-6.375-6.75zm-.919 15.275a30.766 30.766 0 0 1-4.703 3.316l-.004-.002-.004.002a30.955 30.955 0 0 1-4.703-3.316c-2.677-2.307-5.047-5.298-5.047-8.523 0-2.754 2.121-4.5 4.125-4.5 2.06 0 3.914 1.479 4.544 3.684.143.495.596.797 1.086.796.49.001.943-.302 1.085-.796.63-2.205 2.484-3.684 4.544-3.684 2.004 0 4.125 1.746 4.125 4.5 0 3.225-2.37 6.216-5.048 8.523z"
              fill="currentcolor"></path></svg
          ></a
        >
      </div>
      <div class="group">
        <a class="layer" href="https://discord.gg/DSzZQxpzHR">Discord</a>
        <a class="layer" href="https://x.com/KTibow">X</a>
        <a class="layer" href="mailto:little.wire2582@fastmail.com">Email</a>
      </div>
    </div>
    {
      panels.map(([href, stickers]) => (
        <a class="stickers layer" {href}>
          <svg viewBox="0 0 2000 1000" preserveAspectRatio="xMidYMid slice">
            {stickers.map(([img, x, y, w, r]) => {
              const h = (w * img.height) / img.width;
              return (
                <g transform={`translate(${x} ${y}) rotate(${r})`} filter="url(#sticker)">
                  <image href={img.src} x={-w / 2} y={-h / 2} width={w} height={h} />
                </g>
              );
            })}
          </svg>
        </a>
      ))
    }
  </div>
  <Thoughts />
</Base>

<style>
  .quad {
    display: grid;
    @media (width >= 40rem) {
      grid-template-columns: 1fr 1fr;
    }
    margin: 1rem;
    gap: 1rem;
    align-self: center;
  }
  .quad > * {
    position: relative;
    @media (width >= 40rem) {
      width: 20rem;
    }
    min-height: 10rem;
    padding: 1rem;
    border-radius: 2rem;
  }
  .me {
    display: flex;
    align-items: center;
    text-align: center;
    background-color: var(--m3c-surface-container-low);
  }
  .stickers {
    padding: 0;
    overflow: hidden;
    background-color: var(--m3c-surface-container-highest);
    > svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
  }
  .links {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 0.5rem;
    background-color: var(--m3c-primary-container);
    > .split {
      display: flex;
      gap: 0.5rem;
      > :first-child {
        border-start-end-radius: 0.5rem;
        border-end-end-radius: 0.5rem;
        flex-grow: 1;
      }
      > :last-child {
        border-start-start-radius: 0.5rem;
        border-end-start-radius: 0.5rem;
        width: 3rem;
      }
    }
    > .group {
      display: flex;
      gap: 0.5rem;
      a {
        flex-grow: 1;
      }
    }
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--m3c-on-primary-container);
      color: var(--m3c-primary-container);
      border-radius: 1rem;
    }
  }
</style>

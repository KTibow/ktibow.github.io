---
import Base from '$lib/layouts/Base.astro';
import { blogPosts, milliblogPosts } from 'virtual:post-lists';
import statuses from '../nanoblog/statuses.json';
import { formatDate } from './_date';

const thoughtsByYear = Object.groupBy(
  [
    ...blogPosts.map(({ link, title, pubDate, length }) => ({
      url: link,
      title,
      length,
      date: pubDate,
    })),
    ...milliblogPosts.map(({ link, title, pubDate, length }) => ({
      isMilliblog: true,
      url: link,
      title,
      length,
      date: pubDate,
    })),
    ...statuses.map(({ content, timestamp }) => ({
      isStatus: true,
      title: content,
      date: new Date(timestamp),
    })),
  ].sort((a, b) => b.date.getTime() - a.date.getTime()),
  ({ date }) => date.getFullYear().toString(),
);
---

<Base title="Thoughts">
  {
    Object.keys(thoughtsByYear)
      .reverse()
      .map((year) => (
        <>
          <h2>{year}</h2>
          <section>
            {thoughtsByYear[year]!.map((thought) =>
              'url' in thought ? (
                <a
                  class:list={['layer', { milliblog: 'isMilliblog' in thought }]}
                  href={thought.url}
                  style={`--length:${thought.length}`}
                >
                  {thought.title}
                </a>
              ) : (
                <p>
                  <span>{thought.title}</span>
                  <time datetime={thought.date.toISOString()}>{formatDate(thought.date)}</time>
                </p>
              ),
            )}
          </section>
        </>
      ))
  }
  <script>
    import { formatDate } from './_date';
    for (const time of document.querySelectorAll('time')) {
      time.textContent = formatDate(new Date(time.getAttribute('datetime')!));
    }
  </script>
</Base>

<style>
  h2 {
    @apply --m3-headline-large;
    display: flex;
    align-items: center;
    margin: 1.5rem 1.5rem 0;
  }
  section {
    display: flex;
    flex-wrap: wrap;
    margin: 0.75rem 1.5rem 1.5rem;
    gap: 0.5rem;
  }
  a {
    flex: 1 1 8rem;
    border-radius: 1rem;
    padding: 1rem;
    background-color: var(--m3c-surface-container-highest);
    position: relative;
    @media (width >= 40rem) {
      min-width: min(32rem, calc(var(--length) * 0.1px));
    }
    &.milliblog {
      background-color: transparent;
      border: 1px solid var(--m3c-outline);
      color: var(--m3c-on-surface);
    }
  }
  p {
    @apply --m3-body-small;
    flex: 0 1 auto;
    align-self: start;
    border-radius: 1.25rem;
    padding: 0.25rem 0.875rem;
    margin-block-end: 0.5rem;
    background-color: var(--m3c-surface-container-low);
    color: var(--m3c-on-surface-variant);
    position: relative;

    /* thought bubble tail */
    &::before,
    &::after {
      content: '';
      position: absolute;
      border-radius: var(--m3-shape-full);
      background-color: inherit;
    }
    &::before {
      width: 0.625rem;
      height: 0.625rem;
      left: 0.875rem;
      bottom: -0.375rem;
    }
    &::after {
      width: 0.375rem;
      height: 0.375rem;
      left: 0.375rem;
      bottom: -0.9375rem;
    }
  }
  time {
    @apply --m3-label-small;
    margin-inline-start: 0.5rem;
    color: var(--m3c-outline);
    white-space: nowrap;
  }
</style>

---
// Static recreation of Command Code's "Add credits" dialog
---

<div class="moat not-prose">
  <div class="header">
    <span class="label"><span aria-hidden="true" class="slashes">//</span>Add credits</span>
    <svg class="close" aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="M7.5 7.5L16.5 16.5M16.5 7.5L7.5 16.5" stroke="currentColor" stroke-linecap="square"
      ></path>
    </svg>
  </div>
  <div class="body">
    <div class="field">
      <span class="label">Credits amount</span>
      <div class="input">10</div>
      <p class="hint">1 credit = $1 of usage. Credits never expire.</p>
    </div>
    <div class="summary">
      <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"
      ></span><span class="corner br"></span>
      <div class="row"><span>Credits</span><span class="mono">$10.00</span></div>
      <div class="row">
        <mark>Processing fee</mark><mark class="mono">+ $0.78</mark>
      </div>
      <div class="row total"><span>Total</span><span class="mono">$10.78</span></div>
    </div>
    <div class="actions">
      <span class="button">Cancel</span>
      <span class="button">Continue</span>
    </div>
  </div>
</div>

<style>
  .moat {
    --fg: #fff;
    --muted: #a1a1a1;
    --border: #333;
    --bg: #000;
    max-width: 28rem;
    margin: 1.5em auto;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.25rem;
    user-select: none;
    color-scheme: dark;
  }
  .mono,
  .label,
  .input {
    font-family: ui-monospace, 'Monaspace Neon Var', 'SF Mono', Menlo, monospace;
  }
  .label {
    display: flex;
    font-size: 0.75rem;
    line-height: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .slashes {
    opacity: 0.6;
    margin-right: 0.5rem;
    letter-spacing: -0.2em;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .close {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .input {
    padding: 0.625rem 1rem;
    border: 1px solid var(--border);
    line-height: 1.5rem;
  }
  .hint {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--muted);
  }
  .summary {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    font-size: 0.75rem;
    line-height: 1rem;
  }
  .corner {
    position: absolute;
    z-index: 1;
    width: 0.375rem;
    height: 0.375rem;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .tl {
    top: 0;
    left: 0;
    translate: -50% -50%;
  }
  .tr {
    top: 0;
    right: 0;
    translate: 50% -50%;
  }
  .bl {
    bottom: 0;
    left: 0;
    translate: -50% 50%;
  }
  .br {
    bottom: 0;
    right: 0;
    translate: 50% 50%;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
  }
  mark {
    background-color: var(--m3c-primary);
    color: var(--m3c-on-primary);
    border-radius: 4px;
  }
  .total {
    padding-top: 0.5rem;
    margin-top: 0.5rem;
    border-top: 1px dashed var(--border);
    color: var(--fg);
    font-weight: 600;
  }
  .actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    font-weight: 500;
  }
</style>

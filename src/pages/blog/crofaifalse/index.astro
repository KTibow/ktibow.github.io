    <li><code>deepseek-v4-pro-0813</code></li>
    <li><code>glm-5.3-flash</code></li>
    <li><code>glm-5.2</code></li>
    <li><code>qwen3.8-27b</code></li>
    <li><code>qwen3.5-397b-a17b</code></li>
